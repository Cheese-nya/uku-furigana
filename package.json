{
  "name": "uku-furigana",
  "version": "1.5.5",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/vendor-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/vendor-assets.mjs",
    "build": "next build",
    "start": "next start",
    "app": "cmd /c launch_window.bat",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build:web": "node scripts/build-web.mjs",
    "package:exe": "node scripts/build-web.mjs && python -m PyInstaller --noconfirm --onefile --windowed --icon=\"app_icon.ico\" --name UkuFurigana --add-data \"out;out\" desktop_runner.py && copy /y dist\\UkuFurigana.exe .\\UkuFurigana.exe",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "kuromoji": "^0.1.2",
    "next": "16.2.12",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
